{
  "mcpServers": {
    "o2n": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/node_modules/@tk_wfl/o2n-mcp-server/dist/index.js"
      ],
      "env": {
        "NOTION_TOKEN": "${user_config.notion_token}",
        "O2N_ALLOWED_VAULTS": "${user_config.allowed_vaults}",
        "O2N_ENABLE_MCP_WRITE": "${user_config.enable_write}",
        "O2N_MCP_WRITE_TOKEN": "${user_config.write_confirmation_token}",
        "O2N_REQUESTS_PER_SECOND": "${user_config.requests_per_second}"
      }
    }
  }
}
